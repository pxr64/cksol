// Address of a [Solana account][account].
//
// This is a base-58 encoded string with at most 44 characters.
// Example: "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v"
//
// [account]: https://solana.com/docs/core/accounts
type Address = text;

// Represents an account on the ckSOL ledger.
type Account = record {
    owner: principal;
    subaccount: opt blob;
};

// The ID of one of the ICP root keys.
type Ed25519KeyName = variant {
    MainnetTestKey1;
    LocalDevelopment;
    MainnetProdKey1;
};

// Arguments for a request to the `getDepositAddress` ckSOL minter endpoint.
type GetDepositAddressArgs = record {
    // The principal to deposit funds to.
    //
    // If not set, defaults to the caller's principal.
    // The resolved owner must be a non-anonymous principal.
    owner: opt principal;
    // The subaccount to deposit funds to.
    subaccount: opt blob;
};

// Ed25519 signature.
// This is a base-58 encoded string with at most 88 characters.
// Example: "5LrcE2f6uvydKRquEJ8xp19heGxSvqsVbcqUeFoiWbXe8JNip7ftPQNTAVPyTK7ijVdpkzmKKaAQR7MWMmujAhXD"
type Signature = text;

// A 32-byte Solana hash as a base-58 encoded string,
// such as the nonce value stored by a durable nonce account.
type Hash = text;

// Smallest denomination of SOL, the native token on Solana,
// i.e. 1_000_000_000 Lamports is 1 SOL
type Lamport = nat64;

// Index of a burn transaction on the ckSOL ledger.
type LedgerBurnIndex = nat64;

// Index of a mint transaction on the ckSOL ledger.
type LedgerMintIndex = nat64;

// Insufficient cycles attached by the caller to complete the call.
type InsufficientCyclesError = record {
    // The amount of cycles the call requires.
    expected: nat;
    // The amount of cycles received by the minter.
    received: nat;
};

// Arguments for a request to the `deposit_sol` endpoint.
type DepositSolArgs = record {
    // The principal to credit with the deposit.
    //
    // If not set, defaults to the caller's principal.
    // The resolved owner must be a non-anonymous principal.
    owner: opt principal;
    // The subaccount to credit with the deposit.
    subaccount: opt blob;
};

// Identifies a deposit queued by the `deposit_sol` endpoint or by a balance
// scan of the automatic flow, see `watch_deposit_address`.
//
// A sequence number assigned when the deposit is queued.
type DepositSolId = nat64;

// The status of a deposit queued by the `deposit_sol` endpoint or by a balance
// scan of the automatic flow, see `watch_deposit_address`.
type DepositSolStatus = variant {
    // No deposit with this identifier was queued.
    NotFound;
    // The deposit address is queued for a sweep to the minter's main account.
    Queued : record {
        // The amount that will be swept from the deposit address.
        sweepable_amount: Lamport;
    };
    // A Solana transaction sweeping the deposit address to the minter's main
    // account has been submitted but is not yet finalized.
    Swept : record {
        // The signature of the sweep transaction.
        signature: Signature;
    };
    // The sweep transaction was finalized successfully, so the deposited SOL
    // reached the minter's main account, but the ckSOL mint has not landed yet.
    Finalized : record {
        // The signature of the sweep transaction.
        signature: Signature;
    };
    // The minter minted ckSOL for the deposit on the ledger.
    Minted : record {
        // The mint transaction index on the ckSOL ledger.
        block_index: LedgerMintIndex;
        // The minted amount: the swept amount minus the deposit's share of the
        // transaction fee of the sweep.
        minted_amount: Lamport;
    };
    // The sweep transaction failed, or expired without ever being seen on chain,
    // so no ckSOL is owed. Calling `deposit_sol` again queues a new sweep of
    // whatever balance the deposit address still holds.
    Dropped : record {
        // The signature of the sweep transaction.
        signature: Signature;
    };
    // The minter stopped processing the deposit: either the finalized sweep's
    // outcome did not match the plan the minter submitted it with, so the
    // amount to credit cannot be determined safely and no ckSOL was minted, or
    // the ckSOL mint of the credited deposit could not be completed, in which
    // case the mint may nevertheless have landed on the ledger. This is not
    // expected to happen and resolving it requires a minter upgrade: before
    // minting by hand, search the ledger for a mint whose memo carries the
    // sweep signature and the deposit id, otherwise a double mint results.
    // Meanwhile the account stays in flight, so `deposit_sol` and
    // `watch_deposit_address` keep rejecting it and a new deposit has to use a
    // different subaccount.
    Quarantined : record {
        // The signature of the sweep transaction.
        signature: Signature;
    };
};

// An error from the `deposit_sol` endpoint.
type DepositSolError = variant {
    // Insufficient cycles attached by the caller to complete the `deposit_sol` call.
    InsufficientCycles : InsufficientCyclesError;
    // The minter experiences temporary issues, try the call again later.
    TemporarilyUnavailable : text;
    // There is already a concurrent `deposit_sol` invocation for the same account.
    AlreadyProcessing;
    // The balance of the deposit address is below the minimum deposit amount.
    //
    // The minimum deposit amount applies to the balance of the deposit address
    // and includes the rent exemption threshold, so a deposit of exactly the
    // minimum is accepted.
    ValueTooSmall : record {
        // The balance of the deposit address.
        balance: Lamport;
        // The minimum deposit amount for the deposit to be queued.
        minimum_deposit_amount: Lamport;
    };
    // The latest deposit of the account is quarantined: its sweep was finalized,
    // but the outcome did not match the plan the minter submitted, so the deposit
    // could not be credited safely. The account stays rejected until a minter
    // upgrade resolves the quarantined deposit; a new deposit has to use a
    // different subaccount.
    Quarantined : record {
        // The identifier of the quarantined deposit.
        deposit_id: DepositSolId;
    };
};

// Represents the result of a call to the `deposit_sol` endpoint.
type DepositSolResult = variant { Ok : DepositSolId; Err : DepositSolError };

// Arguments for a balance-based SPL deposit request.
type DepositSplArgs = record {
    // The principal to credit. Defaults to the caller when omitted.
    // The resolved owner must be a non-anonymous principal.
    owner: opt principal;
    // The subaccount to credit with the deposit.
    subaccount: opt blob;
    // The Solana mint address identifying the SPL token to deposit.
    mint: Address;
};

// Identifies a deposit queued by the deposit_spl endpoint.
type DepositSplId = nat64;

// Errors returned when an SPL deposit request cannot be queued.
type DepositSplError = variant {
    // A concurrent request for the same IC account and mint is processing.
    AlreadyProcessing;
    InsufficientCycles: InsufficientCyclesError;
    // The required balance includes the configured minimum plus the deposit fee,
    // in the mint's smallest units.
    ValueTooSmall: record { balance: nat64; minimum_deposit_amount: nat64 };
    // The requested mint is not registered as a supported SPL token.
    UnsupportedToken: record { mint: Address };
    // Deposits for this supported token are paused.
    TokenPaused: record { mint: Address };
    // The source or destination token account is frozen, has an unsupported extension,
    // or does not match the expected token program, mint, or owner.
    InvalidTokenAccount: text;
    // The latest deposit of this account and mint is quarantined: the outcome of its
    // sweep did not match the plan, or its mint could not be retried safely. The pair
    // stays rejected until a minter upgrade resolves the deposit; a new deposit has to
    // use a different subaccount.
    Quarantined : record {
        // The identifier of the quarantined deposit.
        deposit_id: DepositSplId;
    };
    TemporarilyUnavailable: text;
};
type DepositSplResult = variant { Ok: DepositSplId; Err: DepositSplError };

// Arguments for a request to the get_spl_deposit_address endpoint.
type GetSplDepositAddressArgs = record {
    // The principal to deposit tokens to. Defaults to the caller when omitted.
    // The resolved owner must be a non-anonymous principal.
    owner: opt principal;
    // The subaccount to deposit tokens to.
    subaccount: opt blob;
    // The Solana mint address identifying the SPL token to deposit.
    mint: Address;
};
type GetSplDepositAddressError = variant {
    // The requested mint is not registered as a supported SPL token.
    UnsupportedToken: record { mint: Address };
};
type GetSplDepositAddressResult = variant { Ok: Address; Err: GetSplDepositAddressError };

// The status of a deposit queued by the `deposit_spl` endpoint.
type DepositSplStatus = variant {
    // No deposit with this identifier was queued.
    NotFound;
    // The token account is queued for a sweep to the minter's treasury token account.
    Queued : record {
        // The recorded balance that will be swept, in the mint's smallest units.
        balance: nat64;
        // The fee quoted at acceptance, in the mint's smallest units.
        fee: nat64;
    };
    // A Solana transaction sweeping the token account to the treasury has been
    // submitted but is not yet finalized.
    Swept : record {
        // The signature of the sweep transaction.
        signature: Signature;
    };
    // The sweep transaction was finalized successfully, so the tokens reached the
    // treasury, but the ckSPL mint has not landed yet.
    Finalized : record {
        // The signature of the sweep transaction.
        signature: Signature;
    };
    // The minter minted ckSPL for the deposit on its token ledger.
    Minted : record {
        // The mint transaction index on the token ledger.
        block_index: nat64;
        // The minted amount: the swept balance minus the fee, in the mint's smallest units.
        minted_amount: nat64;
        // The outcome of the fee mint into the minter's fee subaccount.
        fee: SplFeeMintStatus;
    };
    // The sweep transaction failed, or expired without ever being seen on chain, so no
    // ckSPL is owed. Calling `deposit_spl` again queues a new sweep of whatever balance
    // the token account holds.
    Dropped : record {
        // The signature of the sweep transaction.
        signature: Signature;
    };
    // Either the sweep was finalized but its outcome did not match the plan, so no ckSPL
    // was minted, or the mint could not be retried safely, so the mint outcome requires
    // manual verification. Releasing or crediting the deposit requires a minter upgrade.
    // Meanwhile the account and mint pair stays in flight, so `deposit_spl` keeps
    // rejecting it and a new deposit has to use a different subaccount.
    Quarantined : record {
        // The signature of the sweep transaction.
        signature: Signature;
    };
};

// The outcome of the fee mint of a minted SPL deposit.
type SplFeeMintStatus = variant {
    // The deposit was quoted a zero fee, so there is no fee mint.
    None;
    // The fee mint is queued on the token ledger.
    Pending;
    // The fee was minted into the minter's fee subaccount.
    Minted : record {
        // The fee mint transaction index on the token ledger.
        block_index: nat64;
    };
    // The fee mint cannot be retried safely and requires manual resolution.
    Quarantined;
};

// Orchestrator-supplied configuration, checked against a finalized SPL mint.
// Supports classic SPL Token and Token-2022 mints without extensions.
type AddSplTokenArgs = record {
    mint: Address;
    token_program: Address;
    decimals: nat8;
    ledger_id: principal;
    minimum_deposit_amount: nat64;
    paused: bool;
    // The symbol of the underlying asset on the exchange rate canister, such as `USDC`.
    xrc_symbol: text;
    token_symbol: opt text;
};
type AddSplTokenError = variant {
    AlreadySupported: record { mint: Address };
    LedgerAlreadyUsed: record { ledger_id: principal };
    InvalidToken: text;
    TemporarilyUnavailable: text;
};
type AddSplTokenResult = variant { Ok; Err: AddSplTokenError };
// Arguments for a request to the `watch_deposit_address` endpoint.
type WatchDepositAddressArgs = record {
    // The subaccount of the caller to credit with the deposits detected on
    // its deposit address.
    subaccount: opt blob;
};

// The status of an account registered with `watch_deposit_address`.
type WatchDepositAddressStatus = variant {
    // The deposit address is on the watchlist and scanned on the schedule.
    Watching : record {
        // The end of the registration window, in nanoseconds since the epoch.
        valid_until: nat64;
        // The number of scans of the deposit address so far.
        scan_count: nat32;
        // The time of the last scan, in nanoseconds since the epoch, if any.
        last_scanned_at: opt nat64;
        // The time the next scan is due, in nanoseconds since the epoch, which
        // may lie in the past until the tick that runs the scan, or absent once
        // the schedule leaves no scan before the window closes.
        next_scan_at: opt nat64;
    };
    // A deposit of the account is in flight: queued, swept, finalized or
    // pending its mint.
    Detected : record {
        // The identifier of the deposit in flight.
        deposit_id: DepositSolId;
    };
};

// The successful result of a `watch_deposit_address` call.
type WatchDepositAddressOk = record {
    // The deposit address of the caller's account.
    address: Address;
    // The minimum deposit amount in force at the time of the call.
    minimum_deposit_amount: Lamport;
    // The automatic deposit fee in force at the time of the call.
    automatic_deposit_fee: Lamport;
    // Whether the account is watched or has a deposit in flight.
    status: WatchDepositAddressStatus;
    // The id of the latest deposit queued for the account, if any, whatever
    // stage it reached, to follow with `deposit_sol_status`. For a `Detected`
    // status it is the id of the deposit in flight.
    latest_deposit_id: opt DepositSolId;
};

// An error from the `watch_deposit_address` endpoint.
type WatchDepositAddressError = variant {
    // The latest deposit of the account is quarantined, see `DepositSolError`.
    Quarantined : record {
        // The identifier of the quarantined deposit.
        deposit_id: DepositSolId;
    };
    // The watchlist is full of live registrations, try again later or use
    // `deposit_sol`.
    TooManyWatchedAddresses : record {
        // The id of the latest deposit queued for the account, if any, to
        // follow with `deposit_sol_status`. That deposit is minted or dropped,
        // since an account with a deposit in flight needs no slot.
        latest_deposit_id: opt DepositSolId;
    };
    // The minter experiences temporary issues, try the call again later.
    TemporarilyUnavailable : text;
};

// Represents the result of a call to the `watch_deposit_address` endpoint.
type WatchDepositAddressResult = variant {
    Ok : WatchDepositAddressOk;
    Err : WatchDepositAddressError;
};

// The Solana network to connect to.
type SolanaNetwork = variant {
    Mainnet;
    Devnet;
    Testnet;
};

// The installation args for the ckSOL minter canister.
//
// *WARNING*: Backwards-compatibility is not guaranteed. Fields may be added,
// removed, or renamed across releases.
type InitArgs = record {
    // The only principal allowed to register SPL tokens. If absent, registration is disabled.
    ledger_suite_orchestrator_id: opt principal;
    sol_rpc_canister_id : principal;
    ledger_canister_id : principal;
    master_key_name : Ed25519KeyName;
    deposit_sol_fee : nat64;
    minimum_withdrawal_amount : Lamport;
    minimum_deposit_amount : Lamport;
    withdrawal_fee : Lamport;
    deposit_sol_required_cycles : nat64;
    solana_network : SolanaNetwork;
    nonce_accounts : vec text;
    // The fee in lamports deducted from the minted amount of a deposit detected
    // by the automatic flow. The automatic flow stays unavailable until it is set.
    automatic_deposit_fee : opt Lamport;
};

// Information about the ckSOL minter canister.
type MinterInfo = record {
    deposit_sol_fee : nat;
    minimum_withdrawal_amount : Lamport;
    minimum_deposit_amount : Lamport;
    withdrawal_fee : Lamport;
    deposit_sol_required_cycles : nat;
    balance : Lamport;
    minter_address : opt text;
    nonce_accounts : vec text;
    // The fee in lamports deducted from the minted amount of a deposit detected
    // by the automatic flow, once configured.
    automatic_deposit_fee : opt Lamport;
};

// The ckSOL minter service arguments.
//
// *WARNING*: Backwards-compatibility is not guaranteed. Fields may be added,
// removed, or renamed across releases.
type MinterArg = variant {
    Upgrade : UpgradeArgs;
    Init : InitArgs;
};

// The upgrade args for the ckSOL minter canister.
//
// *WARNING*: Backwards-compatibility is not guaranteed. Fields may be added,
// removed, or renamed across releases.
type UpgradeArgs = record {
    // Sets or replaces the orchestrator. If absent, preserves the current setting.
    ledger_suite_orchestrator_id: opt principal;
    sol_rpc_canister_id : opt principal;
    deposit_sol_fee : opt nat64;
    minimum_withdrawal_amount : opt Lamport;
    minimum_deposit_amount : opt Lamport;
    withdrawal_fee : opt Lamport;
    deposit_sol_required_cycles : opt nat64;
    nonce_accounts_to_add : opt vec text;
    automatic_deposit_fee : opt Lamport;
};

type WithdrawSolArgs = record {
    // The subaccount to burn ckSOL from.
    from_subaccount : opt blob;
    // The amount of ckSOL in Lamports that the client wants to withdraw.
    amount : Lamport;
    // The address to which the ckSOL minter should deposit Solana tokens.
    address : Address;
};

type WithdrawSolOk = record {
    // Returns the burn transaction index corresponding to the withdrawal.
    // You can use this index to query the withdrawal status.
    block_index : LedgerBurnIndex
};

// Arguments for a request to the `withdraw_sol_status` endpoint.
type WithdrawSolStatusArgs = record {
    // The burn block index returned by the `withdraw_sol` endpoint.
    block_index : LedgerBurnIndex;
};

type WithdrawSolError = variant {
    // The minter is already processing another retrieval request for the same
    // principal.
    AlreadyProcessing;
    // The withdrawal amount is too low.
    ValueTooSmall : record {
        // The minimum withdrawal amount.
        minimum_withdrawal_amount : Lamport;
        // The requested withdrawal amount.
        withdrawal_amount : Lamport;
    };
    // The minter failed to parse the destination address.
    MalformedAddress : Address;
    // The destination address is not a valid withdrawal destination.
    // The payload contains a human-readable message explaining why the destination was rejected.
    InvalidDestination : text;
    // The ckSOL balance of the withdrawal account is too low.
    InsufficientFunds : record { balance : Lamport };
    // The minter is not approved to transfer the requested amount.
    InsufficientAllowance : record { allowance : Lamport };
    // The minter is overloaded, retry the request.
    // The payload contains a human-readable message explaining what caused the unavailability.
    TemporarilyUnavailable : text;
};

// The result of a call to the `withdraw_sol` endpoint.
type WithdrawSolResult = variant { Ok : WithdrawSolOk; Err : WithdrawSolError };

type OperatingBalance = record {
    // The part of the minter balance that no ckSOL backs and that the minter may spend on
    // its own costs.
    balance : Lamport;
    // The ckSOL ledger account that receives operating top-ups.
    top_up_account : Account;
};

type OperatingTopUp = record {
    // The burn transaction index on the ckSOL ledger.
    block_index : LedgerBurnIndex;
    // The burned amount added to the operating balance.
    amount : Lamport;
};

type ProcessOperatingTopUpError = variant {
    // Another call is processing the top-up account.
    AlreadyProcessing;
    // The top-up account holds no ckSOL.
    NoFunds;
    // The ledger cannot process the request now, retry later.
    TemporarilyUnavailable : text;
};

type ProcessOperatingTopUpResult = variant {
    Ok : OperatingTopUp;
    Err : ProcessOperatingTopUpError;
};

// Status of a finalized transaction.
type TxFinalizedStatus = variant {
    // Transaction was successful.
    Success : record {
        transaction_id : Signature;
    };
    // Transaction failed.
    Failure : record {
        transaction_id : Signature;
    };
};

// Retrieve the status of a withdrawal request.
type WithdrawSolStatus = variant {
    // Withdrawal request is not found.
    NotFound;
    // Withdrawal request is waiting to be processed.
    Pending;
    // Solana transaction was signed and is sent to the network.
    TxSent : record {
        transaction_id : Signature;
    };
    // Solana transaction is finalized.
    TxFinalized : TxFinalizedStatus;
};

// The mint enqueued for one deposit of a `CreditedSweep` event.
//
// *WARNING*: This type is used exclusively by the debug `get_events` endpoint.
// Backwards-compatibility is not guaranteed.
type CreditedDeposit = record {
    // The identifier of the deposit.
    deposit_id: DepositSolId;
    // The sweepable amount minus the deposit's share of the transaction fee of the sweep.
    amount_to_mint: Lamport;
};

// A validated SPL deposit to mint on its token ledger.
type CreditedSplDeposit = record {
    deposit_id: DepositSplId;
    amount_to_mint: nat64;
};

// Event payload for an accepted ckSOL-to-Solana withdrawal request.
//
// *WARNING*: This type is used exclusively by the debug `get_events` endpoint.
// Backwards-compatibility is not guaranteed.
type AcceptedWithdrawalRequest = record {
    // The ckSOL ledger account.
    account : Account;
    // The solana address to receive the funds.
    solana_address : Address;
    // The index of the ledger block that burned the ckSOL tokens.
    burn_block_index : LedgerBurnIndex;
    // The total amount burned from the user.
    burned_amount : Lamport;
    // The net amount to transfer to the user (burned_amount minus fees).
    amount_to_transfer : Lamport;
};

// A versioned Solana transaction message.
//
// *WARNING*: This type is used exclusively by the debug `get_events` endpoint.
// Backwards-compatibility is not guaranteed.
type VersionedTransactionMessage = variant {
    // A legacy Solana transaction message, serialized with bincode.
    Legacy : blob;
};

// The key that produced one signature of a submitted Solana transaction.
//
// *WARNING*: This type is used exclusively by the debug `get_events` endpoint.
// Backwards-compatibility is not guaranteed.
type Signer = variant {
    // The minter itself, signing with the master key that controls
    // the minter's main address.
    Minter;
    // A minter-controlled account, signing with the key derived
    // for its deposit address.
    Account : Account;
};

// The purpose of a submitted Solana transaction.
//
// *WARNING*: This type is used exclusively by the debug `get_events` endpoint.
// Backwards-compatibility is not guaranteed.
type TransactionPurpose = variant {
    // Sweep the deposit addresses of deposits queued by `deposit_sol` into the
    // minter's main account. The transaction uses a recent blockhash and is
    // dropped once the blockhash expires.
    SweepDeposit : record {
        // The ids of the swept deposits.
        deposit_ids: vec DepositSolId;
        // The block height of the block whose blockhash the transaction uses.
        block_height: nat64;
    };
    // Withdraw SOL to users' Solana addresses. The transaction carries the
    // nonce value of a durable nonce account instead of a recent blockhash,
    // so it never expires.
    Withdrawal : record {
        // The ledger burn indices of the withdrawal requests included in this transaction.
        burn_indices: vec LedgerBurnIndex;
    };
    // Sweep queued SPL token accounts into the minter's associated token accounts.
    // The transaction uses a recent blockhash and is dropped once the blockhash expires.
    SweepSplDeposits : record {
        // The ids of the swept SPL deposits.
        deposit_ids: vec DepositSplId;
        // The block height of the block whose blockhash the transaction uses.
        block_height: nat64;
    };
    // Sweep one retried SPL deposit alone after the batch holding it failed.
    RetrySplDeposit : record {
        // The id of the retried SPL deposit.
        deposit_id: DepositSplId;
        // The block height of the block whose blockhash the transaction uses.
        block_height: nat64;
    };
    // Withdraw SPL tokens using the durable nonce bound to the accepted request.
    SplWithdrawal : record {
        cksol_burn_block_index: LedgerBurnIndex;
    };
};

// Withdrawal terms retained after the ckSOL fee burn.
type SplWithdrawalRequestTerms = record {
    account : Account;
    mint : Address;
    ledger_id : principal;
    address : Address;
    amount : nat64;
    fee : Lamport;
    create_destination_account : bool;
};

// A minter event payload.
//
// *WARNING*: This type is used exclusively by the debug `get_events` endpoint.
// Backwards-compatibility is not guaranteed.
type EventType = variant {
    // A validated SPL token was registered with its IC ledger.
    AddedSplToken : record {
      // The number of token decimals.
      decimals : nat8;
      // The Solana mint address.
      mint : text;
      // The IC ledger assigned to the mint.
      ledger_id : principal;
      // The underlying asset symbol used for XRC requests.
      xrc_symbol : text;
      // The minimum deposit in the token's smallest units.
      minimum_deposit_amount : nat64;
      // The program owning the mint.
      token_program : text;
      // Whether deposits are initially paused.
      paused : bool;
      token_symbol : opt text;
    };
    // The minter initialization event.
    // Must be the first event in the log.
    Init : InitArgs;
    // The minter upgraded with the specified arguments.
    Upgrade : UpgradeArgs;
    // The minter accepted the withdrawal request and
    // burned the requested amount of ckSOL.
    // The Solana transaction was not generated yet.
    AcceptedWithdrawalRequest : AcceptedWithdrawalRequest;
    // Submitted a Solana transaction.
    SubmittedTransaction : record {
        // The signature of the Solana transaction.
        signature: Signature;
        // The versioned transaction message.
        transaction: VersionedTransactionMessage;
        // The signers in signature order (fee payer first).
        signers: vec Signer;
        // The purpose of this transaction, with what the minter needs to
        // track it until it is finalized.
        purpose: TransactionPurpose;
    };
    // A previously submitted Solana transaction has been finalized successfully.
    SucceededTransaction : record {
        // The signature of the succeeded Solana transaction.
        signature: Signature;
    };
    // A previously submitted Solana transaction has failed.
    FailedTransaction : record {
        // The signature of the failed Solana transaction.
        signature: Signature;
    };
    // A previously submitted Solana transaction has an expired blockhash
    // and a null on-chain status, meaning it will never be executed.
    // The deposits of the expired sweep transaction are dropped.
    ExpiredTransaction : record {
        // The signature of the expired Solana transaction.
        signature: Signature;
    };
    // A user queued the deposit address of an account for a sweep via `deposit_sol`.
    QueuedDeposit : record {
        // The identifier of the queued deposit.
        deposit_id: DepositSolId;
        // The account to which the minter should mint ckSOL once the sweep is finalized.
        account: Account;
        // The deposit address derived from the account.
        address: Address;
        // The balance of the deposit address when the deposit was queued.
        balance: Lamport;
    };
    // An SPL token-account balance was accepted for a future sweep.
    QueuedSplDeposit: record {
        deposit_id: DepositSplId;
        account: Account;
        mint: Address;
        address: Address;
        // The token-account balance when the deposit was queued, in the mint's smallest units.
        balance: nat64;
        // The fee deducted from the ledger mint, in the mint's smallest units.
        fee: nat64;
    };
    // The token ledger minted a swept SPL deposit.
    MintedSweptSplDeposit : record {
        // The identifier of the minted SPL deposit.
        deposit_id: DepositSplId;
        // The mint transaction index on the token ledger.
        mint_block_index: nat64;
    };
    // A pending SPL mint cannot be safely retried and its account and mint stay locked.
    QuarantinedPendingSplMint : record {
        // The identifier of the SPL deposit whose pending mint was quarantined.
        deposit_id: DepositSplId;
    };
    // The token ledger minted a deposit fee into the minter's fee subaccount.
    MintedSplDepositFee : record {
        // The identifier of the deposit whose fee was minted.
        deposit_id: DepositSplId;
        // The fee mint transaction index on the token ledger.
        mint_block_index: nat64;
    };
    // A deposit fee mint cannot be safely retried and requires manual resolution.
    QuarantinedPendingSplFeeMint : record {
        // The identifier of the deposit whose pending fee mint was quarantined.
        deposit_id: DepositSplId;
    };
    // The minter burned the ckSOL of its top-up account and added it to the operating balance.
    ToppedUpOperatingBalance : record {
        // The burn transaction index on the ckSOL ledger.
        burn_block_index : LedgerBurnIndex;
        // The burned amount.
        amount : Lamport;
    };
    // A batch failed on chain and its SPL deposits were requeued for individual sweeps.
    SplitFailedSplSweep : record {
        // The signature of the confirmed failed batch transaction.
        signature: Signature;
    };
    // The finalized SPL sweep's outcome did not match its plan, so its deposits stay locked.
    QuarantinedSplSweep : record {
        // The signature of the finalized sweep transaction.
        signature: Signature;
    };
    // A finalized SPL sweep was validated and its deposits queued for ledger minting.
    CreditedSplSweep : record {
        // The signature of the finalized sweep transaction.
        signature: Signature;
        // The main account's spend on the transaction fee and destination rent.
        lamports_spent: Lamport;
        // The mint enqueued for each deposit of the sweep.
        mints: vec CreditedSplDeposit;
    };
    // The minter read the amount that the finalized sweep transaction moved to
    // its main account and enqueued a pending mint for each deposit of that sweep.
    CreditedSweep : record {
        // The signature of the finalized sweep transaction.
        signature: Signature;
        // The increase of the main account balance reported by the transaction metadata.
        amount_received: Lamport;
        // The mint enqueued for each deposit of the sweep, by increasing deposit id.
        mints: vec CreditedDeposit;
    };
    // The outcome of a finalized sweep transaction did not match the plan the
    // minter submitted it with, so the amount to credit cannot be determined
    // safely.
    //
    // The deposits are quarantined to avoid any double minting and will not be
    // further processed without a minter upgrade.
    QuarantinedSweep : record {
        // The signature of the finalized sweep transaction.
        signature: Signature;
    };
    // The minter fetched its Schnorr Ed25519 master public key, from which
    // its main address and all deposit addresses are derived.
    MinterPublicKeyFetched : record {
        // The raw Ed25519 master public key (32 bytes).
        public_key: blob;
        // The chain code used to derive subkeys (32 bytes).
        chain_code: blob;
    };
    // The minter minted ckSOL on the ledger for a swept deposit whose sweep
    // was credited.
    MintedSweptDeposit : record {
        // The identifier of the minted deposit.
        deposit_id: DepositSolId;
        // The mint transaction index on the ckSOL ledger.
        mint_block_index: LedgerMintIndex;
    };
    // The pending mint of a swept deposit cannot be retried: either it became
    // older than the 24-hour deduplication window of the ckSOL ledger, or the
    // ledger definitively rejected it. Retrying the transfer with the same
    // arguments fails forever, and fresh arguments could double mint.
    //
    // The deposit is quarantined to avoid any double minting and will not be
    // further processed without manual intervention.
    //
    // If the minter was down past the deduplication window, the underlying
    // transfer may nevertheless have landed on the ledger. Manual resolution
    // must therefore first search the ledger for a mint whose memo carries the
    // sweep signature before crediting by hand, otherwise a double mint
    // results.
    QuarantinedPendingMint : record {
        // The identifier of the deposit whose pending mint was quarantined.
        deposit_id: DepositSolId;
    };
    // The minter bound a durable nonce account and its nonce value to the
    // withdrawal requests of the given burn indices, before requesting the
    // threshold signature. The binding determines the transaction message.
    CreatedWithdrawalTransaction : record {
        // The ledger burn indices of the withdrawal requests served by this transaction.
        burn_indices: vec LedgerBurnIndex;
        // The durable nonce account bound to this transaction.
        nonce_account: Address;
        // The nonce value the transaction carries in place of a recent blockhash.
        nonce_value: Hash;
    };
    // The token burn succeeded and the withdrawal was accepted for processing.
    AcceptedSplWithdrawalRequest : record {
        terms : SplWithdrawalRequestTerms;
        cksol_burn_block_index : nat64;
        ckspl_burn_block_index : nat64;
    };
    // The token burn returned an error; reimburse the already burned ckSOL fee.
    FailedSplWithdrawalRequest : record {
        cksol_burn_block_index : nat64;
        reimbursed_amount : Lamport;
        to : Account;
    };
    // The ckSOL fee of a failed SPL withdrawal was minted back.
    ReimbursedSplWithdrawalFee : record {
        cksol_burn_block_index : nat64;
        mint_block_index : nat64;
    };
    // A fee reimbursement cannot be safely retried and requires manual resolution.
    QuarantinedSplWithdrawalFeeReimbursement : record {
        cksol_burn_block_index : nat64;
    };
    // An accepted SPL withdrawal was bound to a durable nonce before signing.
    CreatedSplWithdrawalTransaction : record {
        cksol_burn_block_index : nat64;
        nonce_account : Address;
        nonce_value : Hash;
    };
};

// A minter event.
//
// *WARNING*: This type is used exclusively by the debug `get_events` endpoint.
// Backwards-compatibility is not guaranteed.
type Event = record {
    timestamp : nat64;
    payload : EventType;
};

// Arguments for the `get_events` endpoint.
//
// *WARNING*: This type is used exclusively by the debug `get_events` endpoint.
// Backwards-compatibility is not guaranteed.
type GetEventsArgs = record {
    start : nat64;
    length : nat64;
};

// The result of a `get_events` call.
//
// *WARNING*: This type is used exclusively by the debug `get_events` endpoint.
// Backwards-compatibility is not guaranteed.
type GetEventsResult = record {
    events : vec Event;
    total_event_count : nat64;
};

service : (MinterArg) -> {
    // Returns the Solana address to which the owner should send SOL.
    //
    // If the owner is not set, it defaults to the caller's principal.
    // The resolved owner must be a non-anonymous principal.
    get_deposit_address: (GetDepositAddressArgs) -> (Address);

    // Queues the deposit address of the given account for a sweep
    // to the minter's main account and returns the identifier of
    // the queued deposit, which can be used to query its status.
    //
    // If the owner is not set, it defaults to the caller's principal.
    // The resolved owner must be a non-anonymous principal.
    deposit_sol: (DepositSolArgs) -> (DepositSolResult);

    // Queues a finalized SPL balance for sweeping to the minter and minting on its token ledger.
    // The token fee quoted at acceptance is deducted from the ledger mint.
    // Once the user mint succeeds, that fee is minted into the minter's fee subaccount.
    // New deposits cover two account reads, an XRC quote and a consolidation fee in cycles;
    // the fee is charged only when the account checks and quoted net minimum succeed. Repeated requests for
    // an in-flight account and mint return the existing ID without a charge, also when paused.
    deposit_spl: (DepositSplArgs) -> (DepositSplResult);

    // Returns the token account to which the owner should send the SPL tokens of the
    // given mint: the associated token account of the deposit address under the token
    // program registered for the mint.
    //
    // If the owner is not set, it defaults to the caller's principal.
    // The resolved owner must be a non-anonymous principal.
    get_spl_deposit_address: (GetSplDepositAddressArgs) -> (GetSplDepositAddressResult);

    // Registers an SPL token and its IC ledger. Only the configured orchestrator can
    // call it, and Token-2022 mints with extensions are rejected. The exchange rate
    // canister must quote SOL in the token's symbol.
    add_spl_token: (AddSplTokenArgs) -> (AddSplTokenResult);

    // Returns the status of the deposit with the given identifier,
    // or `NotFound` if no deposit with this identifier was queued.
    deposit_sol_status: (DepositSolId) -> (DepositSolStatus) query;

    // Returns the status of the SPL deposit with the given identifier,
    // or `NotFound` if no deposit with this identifier was queued.
    deposit_spl_status: (DepositSplId) -> (DepositSplStatus) query;
    // Registers the deposit address of the caller's account for the
    // automatic deposit flow, for free, or reports on its registration:
    // the minter reads the balance of the address on a schedule for about
    // a day and queues a sweep once it reaches the minimum deposit amount,
    // deducting the automatic deposit fee from the minted amount.
    //
    // The owner is always the caller, who must be a non-anonymous principal.
    watch_deposit_address: (WatchDepositAddressArgs) -> (WatchDepositAddressResult);

    // Submits a request to convert ckSOL to Solana.
    withdraw_sol : (WithdrawSolArgs) -> (WithdrawSolResult);

    // Retrieve the status of a Solana withdrawal request.
    withdraw_sol_status : (WithdrawSolStatusArgs) -> (WithdrawSolStatus);

    // Burns the ckSOL in the operating top-up account and adds it to the operating balance,
    // which pays the minter's own Solana costs, such as SPL sweeps.
    process_operating_top_up : () -> (ProcessOperatingTopUpResult);

    // Returns the operating balance and the account that receives operating top-ups.
    get_operating_balance : () -> (OperatingBalance) query;

    // *WARNING*: This is a debug endpoint, backwards-compatibility is not guaranteed.
    // Returns events from the event log starting at the given index.
    // The response contains at most 2000 events.
    get_events: (GetEventsArgs) -> (GetEventsResult) query;

    // Returns information about the ckSOL minter canister.
    get_minter_info: () -> (MinterInfo) query;
};
